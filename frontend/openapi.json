        ],
        "operationId": "searchFlights",
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "[A-Za-z]{3}",
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "[A-Za-z]{3}",
