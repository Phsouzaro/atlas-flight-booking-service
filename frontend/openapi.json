  "components": {
    "schemas": {
      "PendingActionView": {
        "required": [
          "createdAt",
          "decidedAt",
          "expiresAt",
          "id",
          "payload",
          "result",
          "status",
          "summary",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "summary": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "nullable": true
            },
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ConfirmRequest": {
        "required": [
          "cardToken"
        ],
        "type": "object",
        "properties": {
          "cardToken": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        }
      },
      "HoldBookingCommand": {
        "required": [
          "fareClass",
          "flightId",
          "passengers"
        ],
        "type": "object",
        "properties": {
          "flightId": {
            "type": "string",
            "format": "uuid"
          },
          "fareClass": {
            "minLength": 1,
            "type": "string"
          },
          "passengers": {
            "maxItems": 9,
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PassengerInfo"
            }
          }
        }
      },
      "PassengerInfo": {
        "required": [
          "birthDate",
          "documentNumber",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          },
          "documentNumber": {
            "maxLength": 30,
            "minLength": 0,
            "pattern": "[A-Za-z0-9.\\-]+",
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "BookingView": {
        "required": [
          "cancelledAt",
          "code",
          "confirmedAt",
          "createdAt",
          "expiredAt",
          "holdExpiresAt",
          "id",
          "items",
          "passengers",
          "paymentReference",
          "rebookedAt",
          "rebookedFromId",
          "rebookedToId",
          "refund",
          "status",
          "total"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "HELD",
              "CONFIRMED",
              "CANCELLED",
              "REBOOKED",
              "EXPIRED"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "holdExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "rebookedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "paymentReference": {
            "type": "string",
            "nullable": true
          },
          "refund": {
            "$ref": "#/components/schemas/Money"
          },
          "rebookedFromId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "rebookedToId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "passengers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PassengerInfo"
            }
          }
        }
      },
      "Item": {
        "required": [
          "departureAt",
          "destination",
          "fareClass",
          "flightId",
          "flightNumber",
          "origin",
          "seats",
          "unitPrice"
        ],
        "type": "object",
        "properties": {
          "flightId": {
            "type": "string",
            "format": "uuid"
          },
          "flightNumber": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "fareClass": {
            "type": "string"
          },
          "seats": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "Money": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "RebookingRequest": {
        "required": [
          "fareClass",
          "flightId"
        ],
        "type": "object",
        "properties": {
          "flightId": {
            "type": "string",
            "format": "uuid"
          },
          "fareClass": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "RebookingProposal": {
        "required": [
          "amountDue",
          "bookingCode",
          "bookingId",
          "changeFee",
          "expiresAt",
          "fareDifference",
          "newDepartureAt",
          "newFareClass",
          "newFlightId",
          "newFlightNumber",
          "pendingActionId",
          "seats"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "bookingCode": {
            "type": "string"
          },
          "newFlightId": {
            "type": "string",
            "format": "uuid"
          },
          "newFlightNumber": {
            "type": "string"
          },
          "newDepartureAt": {
            "type": "string",
            "format": "date-time"
          },
          "newFareClass": {
            "type": "string"
          },
          "seats": {
            "type": "integer",
            "format": "int32"
          },
          "changeFee": {
            "$ref": "#/components/schemas/Money"
          },
          "fareDifference": {
            "$ref": "#/components/schemas/Money"
          },
          "amountDue": {
            "$ref": "#/components/schemas/Money"
          },
          "pendingActionId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConfirmBookingRequest": {
        "required": [
          "cardToken"
        ],
        "type": "object",
        "properties": {
          "cardToken": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
